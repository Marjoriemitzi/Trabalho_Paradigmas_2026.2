POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finance

APP_DB_USER=finance_app
APP_DB_PASSWORD=troque-esta-outra-senha

LOG_LEVEL=INFO

ENABLE_DOCS=true

JWT_SECRET=troque-este-segredo-por-um-gerado-com-openssl
# Validade do access token (curto) e do refresh token (em dias).
JWT_EXPIRES_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Origens do frontend liberadas no CORS, separadas por vírgula, sem barra no fim.
# Vazio = sem CORS. Exemplo: http://localhost:8001,http://127.0.0.1:8001
CORS_ORIGINS=

# IPs de proxy confiáveis para ler o X-Forwarded-For (uvicorn). Vazio = não confia em nenhum.
# Só preencha se a API roda atrás de um proxy seu; o limite de tentativas usa esse IP.
FORWARDED_ALLOW_IPS=

# Fuso horário da aplicação: define "hoje" para recorrências e metas (nome IANA).
TIMEZONE=America/Sao_Paulo

# Ambiente: development, test ou production. O padrão da aplicação é production; só o
# development deixa rodar o comando de dados de demonstração.
APP_ENV=development
# Senha do usuário de demonstração (opcional; sem ela o comando gera e imprime uma).
DEMO_PASSWORD=

# Copie para .env e troque TODAS as senhas:  cp .env.example .env
# Gere senhas fortes com:  openssl rand -hex 32
# (use só letras e números, porque as senhas entram numa URL de conexão)

# Superusuário do Postgres: usado só para criar o banco. A API nunca recebe estas credenciais.
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finance

# Usuário comum que a API usa para acessar o banco
APP_DB_USER=finance_app
APP_DB_PASSWORD=troque-esta-senha-tambem

LOG_LEVEL=INFO

# Documentação interativa (/docs, /redoc, /openapi.json). Mantenha false em produção.
ENABLE_DOCS=true
